{
  "name": "evolutionary-cli-wrapper",
  "version": "3.6.1-rc.1",
  "description": "CLI wrapper that scores and guides LLM collaboration efficiency without depending on token access.",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "evo": "dist/evo.bundle.cjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run bundle",
    "bundle": "node scripts/bundle.mjs",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:release": "npm run clean:dist && tsc -p tsconfig.build.json && npm run bundle",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build:release",
    "setup": "node scripts/setup.mjs",
    "test": "vitest run tests",
    "test:watch": "vitest tests",
    "release:check": "npm run build && npm test",
    "version:show": "node -p \"require('./package.json').version\""
  },
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "cli",
    "statusline",
    "prompt-engineering",
    "llm",
    "developer-tools",
    "productivity",
    "gamification",
    "mascot",
    "typescript"
  ],
  "author": "1-10maru",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/1-10maru/evolutionary-cli-wrapper/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "statusline.py",
    "scripts/token_statusline.py"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/1-10maru/evolutionary-cli-wrapper.git"
  },
  "homepage": "https://github.com/1-10maru/evolutionary-cli-wrapper#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "esbuild": "^0.25.5",
    "tsx": "^4.21.0",
    "turndown": "^7.2.4",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "strip-ansi": "^7.2.0",
    "tree-sitter": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2"
  }
}
